# Casey deployment configuration.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and is the ONLY
# place deployment-specific or sensitive values should live. It is read by
# app.py (python-dotenv), by the Slack CLI (`slack run`), and by scripts/dev.sh.
# To migrate to another machine, copy `.env` and the credentials file it points to.

# --- OpenCode -----------------------------------------------------------------

# Required. The opencode server Casey talks to (scripts/dev.sh starts one here).
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Required. Model as <provider>/<model>, from `opencode models`.
OPENCODE_MODEL=your-provider/your-model

# Required by scripts/dev.sh. A shell file that `export`s the model provider's
# credentials (API keys, bearer tokens, AWS vars...). It is sourced only into the
# opencode server process and re-read automatically whenever the file changes.
# Keep it outside the repository.
CASEY_CREDENTIALS_FILE=/absolute/path/to/credentials.sh

# Optional. Port and binaries used by scripts/dev.sh.
# OPENCODE_PORT=4096
# OPENCODE_BIN=opencode
# SLACK_BIN=~/.slack/bin/slack

# --- Slack --------------------------------------------------------------------

# Required by scripts/dev.sh. The app ID from App Settings (A0...).
SLACK_APP_ID=A0XXXXXXXXX

# Optional, uncomment and set when running without the Slack CLI (python3 app.py).
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...

# Required for OAuth (app_oauth.py). Set your app's OAuth credentials.
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_SIGNING_SECRET=...
# SLACK_REDIRECT_URI=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/slack/oauth_redirect

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=https://slack.com/api
